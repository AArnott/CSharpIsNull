<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- These versions deliberately target the oldest supported host, Visual Studio 2022 version 17.14.
       Keep this compatibility baseline independent from repository defaults, even when they coincide.
       See https://learn.microsoft.com/visualstudio/extensibility/roslyn-version-support?view=visualstudio. -->
  <PropertyGroup>
    <CodeAnalysisVersionForAnalyzers>4.14.0</CodeAnalysisVersionForAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Update="Microsoft.CodeAnalysis" Version="$(CodeAnalysisVersionForAnalyzers)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="$(CodeAnalysisVersionForAnalyzers)" />
    <PackageVersion Update="Microsoft.CodeAnalysis.CSharp" Version="$(CodeAnalysisVersionForAnalyzers)" />
    <PackageVersion Update="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(CodeAnalysisVersionForAnalyzers)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="$(CodeAnalysisVersionForAnalyzers)" />
    <PackageVersion Include="Humanizer.Core" Version="2.14.1" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.19" />
    <PackageVersion Include="System.Buffers" Version="4.5.1" />
    <PackageVersion Include="System.Collections.Immutable" Version="9.0.19" />
    <PackageVersion Include="System.Composition" Version="9.0.19" />
    <PackageVersion Include="System.Composition.AttributedModel" Version="9.0.19" />
    <PackageVersion Include="System.Composition.Convention" Version="9.0.19" />
    <PackageVersion Include="System.Composition.Hosting" Version="9.0.19" />
    <PackageVersion Include="System.Composition.Runtime" Version="9.0.19" />
    <PackageVersion Include="System.Composition.TypedParts" Version="9.0.19" />
    <PackageVersion Include="System.IO.Pipelines" Version="9.0.19" />
    <PackageVersion Include="System.Memory" Version="4.5.5" />
    <PackageVersion Include="System.Numerics.Vectors" Version="4.5.0" />
    <PackageVersion Include="System.Reflection.Metadata" Version="9.0.19" />
    <PackageVersion Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="7.0.0" />
    <PackageVersion Include="System.Threading.Channels" Version="7.0.0" />
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
  </ItemGroup>
</Project>
